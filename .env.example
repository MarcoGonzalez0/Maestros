# Copia este archivo como .env y completa los valores.
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Contraseña de tu usuario de MySQL
MYSQL_PASSWORD=tu-contraseña-de-mysql

# Opcionales (valores por defecto: localhost, 3306, root, maestros)
#MYSQL_HOST=localhost
#MYSQL_PORT=3306
#MYSQL_USER=root
#MYSQL_DB=maestros